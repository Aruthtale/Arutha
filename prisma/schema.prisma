generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                @id @default(cuid())
  supabase_id     String?               @unique
  email           String                @unique
  password        String?
  username        String                @unique
  usia            Int?
  gender          String?
  level           Int                   @default(1)
  xp              Int                   @default(0)
  activeQuests    Json?                 @map("active_quests")
  lastQuestUpdate DateTime              @default(now()) @map("last_quest_update")
  refreshCount    Int                   @default(0) @map("refresh_count")
  lastRefreshDate DateTime              @default(now()) @map("last_refresh_date")
  lastActiveDate  DateTime              @default(now()) @map("last_active_date")
  fatigueDays     Int                   @default(0) @map("fatigue_days")
  nameChangeCount Int                   @default(0) @map("name_change_count")
  lastNameChange  DateTime?             @map("last_name_change")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  profiles        CharacterProfile[]
  reflections     DimensionReflection[]
  questLogs       QuestLog[]
  statHistory     StatHistory[]

  @@map("arutha_user")
}

model CharacterProfile {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality_type  String
  personality_title String
  personality_desc  String
  character_summary String
  jiwa              Int
  raga              Int
  harta             Int
  ilmu              Int
  karma             Int
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("character_profile")
}

model StatHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jiwa      Int      @default(0)
  raga      Int      @default(0)
  harta     Int      @default(0)
  ilmu      Int      @default(0)
  karma     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("stat_history")
}

model QuestLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  stat_type   String
  xp_gained   Int      @map("xp_gained")
  user_note   String?  @map("user_note")
  completedAt DateTime @default(now()) @map("completed_at")

  @@index([userId])
  @@map("quest_logs")
}

model DimensionReflection {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension       String
  reflection_text String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("dimension_reflections")
}
