// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  supabase_id     String?  @unique
  email           String   @unique
  password        String?
  username        String   @unique
  usia            Int?
  gender          String?
  level           Int      @default(1)
  xp              Int      @default(0)
  activeQuests    Json?    // Menyimpan quest harian aktif
  lastQuestUpdate DateTime @default(now())
  
  // Fitur Anti-Curang
  refreshCount    Int      @default(0)
  lastRefreshDate DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profiles        CharacterProfile[]
  statHistory     StatHistory[]
  questLogs       QuestLog[]
  reflections     DimensionReflection[]

  @@map("arutha_user") // Nama tabel huruf kecil semua
}

model CharacterProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  personality_type  String
  personality_title String
  personality_desc  String
  character_summary String
  
  jiwa              Int
  raga              Int
  harta             Int
  ilmu              Int
  karma             Int
  
  createdAt         DateTime @default(now())

  @@index([userId])
  @@map("character_profile") // Nama tabel huruf kecil semua
}

model StatHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  jiwa      Int      @default(0)
  raga      Int      @default(0)
  harta     Int      @default(0)
  ilmu      Int      @default(0)
  karma     Int      @default(0)
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("stat_history")
}

model QuestLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  stat_type   String   // 'JIWA', 'RAGA', 'HARTA', 'ILMU', 'KARMA'
  xp_gained   Int
  user_note   String?  // Bukti penyelesaian quest
  
  completedAt DateTime @default(now())

  @@index([userId])
  @@map("quest_logs")
}

model DimensionReflection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dimension       String   // 'JIWA', 'RAGA', 'HARTA', 'ILMU', 'KARMA'
  reflection_text String
  
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("dimension_reflections")
}
