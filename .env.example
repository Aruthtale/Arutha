# Supabase Public Keys (Safe for Client)
VITE_SUPABASE_URL="your-supabase-url"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# AI Keys (Vulnerable to exposure if on client)
VITE_GEMINI_API_KEY="your-gemini-key"

# --- SERVER SIDE ONLY / SECRETS ---
# DO NOT PREFIX WITH VITE_ IF USING VITE
# DO NOT COMMIT THESE TO PUBLIC REPOS

# Prisma Database
DATABASE_URL="postgresql://postgres..."
DIRECT_URL="postgresql://postgres..."

# Supabase Admin (CRITICAL SECRET)
# Bypasses all RLS policies. Keep this very safe.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="your-nextauth-secret"
